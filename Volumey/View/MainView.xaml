<ui:FluentWindow x:Class="Volumey.View.MainView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                 xmlns:view="clr-namespace:Volumey.View"
                 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:converters="clr-namespace:Volumey.View.Converters"
                 xmlns:lc="clr-namespace:Volumey.Localization"
                 mc:Ignorable="d"
                 Name="Window"
                 Title="Volumey"
                 Width="368"
                 MinWidth="368"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual"
                 IsVisibleChanged="OnIsVisibleChanged"
                 PreviewKeyDown="OnKeyDown"
                 Loaded="OnLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <converters:DeviceIsDefaultToIconConverter x:Key="DeviceIsDefaultToIconConverter"/>

            <!-- WPF-UI's menu shadow with the slide-in. The shadow has a border of its own behind the items:
                 an element with an effect is drawn into a bitmap first, and at scales like 175% that bitmap
                 lands between pixels and blurs the text -->
            <DropShadowEffect x:Key="TrayMenuShadow" BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />

            <Storyboard x:Key="TrayMenuSlideIn">
                <DoubleAnimation
                    Storyboard.TargetName="Panel"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                    From="-90"
                    To="0"
                    Duration="00:00:00.167">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- WPF-UI's context menu template with the shadow on its own border -->
            <ControlTemplate x:Key="TrayMenuTemplate" TargetType="{x:Type ContextMenu}">
                <ui:EffectThicknessDecorator Thickness="30">
                    <Grid x:Name="Panel">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Effect="{StaticResource TrayMenuShadow}" />
                        <Border
                            Padding="0,3,0,3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            UseLayoutRounding="True">
                            <StackPanel
                                ClipToBounds="True"
                                IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                Orientation="Vertical" />
                        </Border>
                    </Grid>
                </ui:EffectThicknessDecorator>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsOpen" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource TrayMenuSlideIn}" />
                        </Trigger.EnterActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- WPF-UI's template of a menu item with a submenu, with the submenu's shadow on its own border -->
            <ControlTemplate x:Key="TraySubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="Border"
                        Grid.Row="1"
                        Margin="4,1,4,1"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid x:Name="MenuItemContent" Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="Icon"
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                KeyboardNavigation.IsTabStop="False" />
                            <ContentPresenter
                                x:Name="Header"
                                Grid.Column="1"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                            <ui:SymbolIcon
                                x:Name="Chevron"
                                Grid.Column="2"
                                Margin="0,3,0,0"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                Symbol="ChevronRight20" />
                        </Grid>
                    </Border>

                    <Popup
                        x:Name="Popup"
                        Grid.Row="1"
                        AllowsTransparency="True"
                        Focusable="False"
                        IsOpen="{TemplateBinding IsSubmenuOpen}"
                        Placement="Right"
                        PlacementTarget="{Binding ElementName=MenuItemContent}"
                        PopupAnimation="None"
                        VerticalOffset="-20">
                        <Grid x:Name="Panel" Margin="12,10,12,30">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Border
                                Background="{DynamicResource FlyoutBackground}"
                                CornerRadius="8"
                                Effect="{StaticResource TrayMenuShadow}" />
                            <Border
                                Padding="0,3,0,3"
                                Background="{DynamicResource FlyoutBackground}"
                                BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <ui:PassiveScrollViewer
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ui:PassiveScrollViewer>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Icon" Value="{x:Null}">
                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Icon" Property="Margin" Value="0" />
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsPressed" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsPressed" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundPressed}" />
                        <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
                        <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Chevron" Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource TrayMenuSlideIn}" />
                        </Trigger.EnterActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 248 wide, the default item in bold, with the two Windows sound items -->
            <ContextMenu x:Key="TrayMenu" MinWidth="248" Template="{StaticResource TrayMenuTemplate}">
                <MenuItem
                    Header="{lc:Localization Tray_OpenMixer}"
                    FontWeight="SemiBold"
                    Command="{Binding Window.TrayMixerCommand}"
                    Icon="{ui:SymbolIcon Options24}" />
                <MenuItem
                    Header="{lc:Localization TabHeader_Settings}"
                    Command="{Binding Window.TraySettingsCommand}"
                    Icon="{ui:SymbolIcon Settings24}" />
                <MenuItem
                    Header="{lc:Localization Mixer_OutputDevice}"
                    ItemsSource="{Binding Devices.DeviceProvider.ActiveDevices}"
                    Template="{StaticResource TraySubmenuHeaderTemplate}"
                    Icon="{ui:SymbolIcon Headphones24}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Icon">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource DeviceIsDefaultToIconConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.Devices.DefaultDevice" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Header" Value="{Binding Master.DeviceFriendlyName}"/>
                            <Setter Property="Command" Value="{Binding DataContext.Devices.SetDefaultDeviceTrayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem
                    Header="{lc:Localization TrayMenu_SoundPanel}"
                    Command="{Binding Window.SoundControlPanelCommand}"
                    Icon="{ui:SymbolIcon Speaker224}" />
                <MenuItem
                    Header="{lc:Localization TrayMenu_SoundSettings}"
                    Command="{Binding Window.SoundSettingsCommand}"
                    Visibility="{Binding Window.CanOpenSoundSettings, Converter={StaticResource BoolToVisibility}}"
                    Icon="{ui:SymbolIcon Open24}" />
                <Separator />
                <MenuItem
                    Header="{lc:Localization TrayMenu_Exit}"
                    Command="{Binding Window.TrayExitCommand}"
                    Icon="{ui:SymbolIcon Power24}" />
            </ContextMenu>

            <Storyboard x:Key="DisplayFadeIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 Storyboard.Target="{Binding ElementName=Window}"
                                 From="0" To="1" Duration="0:0:.12" />
            </Storyboard>

            <Storyboard x:Key="HideFadeOut">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 Storyboard.Target="{Binding ElementName=Window}"
                                 From="1" To="0" Duration="0:0:.12" />
            </Storyboard>

            <converters:WindowVisibilityConverter x:Key="WindowVisibilityConverter" />
            <converters:TrayTooltipConverter x:Key="TrayTooltipConverter"/>
            <converters:TrayIconConverter x:Key="TrayIconConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <MultiBinding x:Key="TrayIconBinding"
                          Converter="{StaticResource TrayIconConverter}">
                <Binding Path="Devices.DeviceProvider.NoOutputDevices" />
                <Binding Path="Devices.DefaultDevice.Master.Volume" />
                <Binding Path="Devices.DefaultDevice.Master.IsMuted" />
                <Binding Path="Theme.WindowsTheme" />
                <Binding Path="Window.DisplayDeviceIconAtTray"/>
                <Binding Path="Devices.DefaultDevice.Master.Icon" />
            </MultiBinding>

            <MultiBinding x:Key="TrayTextTooltip"
                          Converter="{StaticResource TrayTooltipConverter}">
                <Binding Path="Devices.DeviceProvider.NoOutputDevices"/>
                <Binding Path="Devices.DefaultDevice.Master"/>
                <Binding Path="Devices.DefaultDevice.Master.IsMuted"/>
                <Binding Path="Devices.DefaultDevice.Master.Volume"/>
                <Binding Source="{x:Static lc:TranslationSource.Instance}"
                         Path="CurrentCulture"/>
                <Binding Path="Devices.DefaultDevice.Master.DeviceFriendlyName"/>
            </MultiBinding>
        </ResourceDictionary>
    </Window.Resources>

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger
            EventName="Closing"
            SourceObject="{Binding ElementName=Window}">
            <behaviors:InvokeCommandAction Command="{Binding Path=Window.ClosingCommand}"
                                           PassEventArgsToCommand="True"/>
        </behaviors:EventTrigger>

        <behaviors:DataTrigger
            Binding="{Binding ElementName=Window, Path=IsVisible}"
            Value="False"
            Comparison="Equal">
            <behaviors:ControlStoryboardAction Storyboard="{StaticResource HideFadeOut}"/>
        </behaviors:DataTrigger>

        <behaviors:DataTrigger
            Binding="{Binding ElementName=Window, Path=IsVisible}"
            Value="True"
            Comparison="Equal">
            <behaviors:ControlStoryboardAction Storyboard="{StaticResource DisplayFadeIn}"/>
        </behaviors:DataTrigger>

        <behaviors:EventTrigger
            EventName="Deactivated"
            SourceObject="{Binding ElementName=Window}">
            <behaviors:InvokeCommandAction Command="{Binding Path=Window.LostFocusCommand}"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.ShowInTaskbar>
        <Binding Path="Window.DisplayMinimalistic" Converter="{StaticResource InverseBoolConverter}"/>
    </Window.ShowInTaskbar>

    <Window.Visibility>
        <Binding Path="Window.WindowIsVisible" Converter="{StaticResource WindowVisibilityConverter}" />
    </Window.Visibility>

    <Window.Topmost>
        <Binding Path="Window.AlwaysOnTop"/>
    </Window.Topmost>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            Name="Tray"
            NoLeftClickDelay="True"
            LeftClickCommand="{Binding Window.TrayClickCommand}"
            ContextMenu="{StaticResource TrayMenu}" />

        <!-- window mode only; the popup has no title bar. Minimize and maximize are off:
             the window hides to the tray instead -->
        <ui:TitleBar
            x:Name="TitleBar"
            Title="Volumey"
            Icon="{ui:SymbolIcon Speaker224}"
            ShowMinimize="False"
            ShowMaximize="False"
            Visibility="{Binding Window.DisplayMinimalistic, Converter={StaticResource InverseBoolToVisibility}}" />

        <view:MixerView
            x:Name="Mixer"
            Grid.Row="1" />

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
