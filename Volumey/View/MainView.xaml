<ui:FluentWindow x:Class="Volumey.View.MainView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                 xmlns:view="clr-namespace:Volumey.View"
                 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:converters="clr-namespace:Volumey.View.Converters"
                 xmlns:lc="clr-namespace:Volumey.Localization"
                 mc:Ignorable="d"
                 Name="Window"
                 Title="Volumey"
                 Width="368"
                 MinWidth="368"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual"
                 DataContext="{StaticResource AppBehaviorViewModel}"
                 IsVisibleChanged="OnIsVisibleChanged"
                 PreviewKeyDown="OnKeyDown"
                 Loaded="OnLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <converters:DeviceIsDefaultToIconConverter x:Key="DeviceIsDefaultToIconConverter"/>

            <!-- mockup TrayMenu.dc.html (248 wide, the default item in bold), plus the two Windows sound items (owner's decision;
                 no "Start with Windows" item) -->
            <ContextMenu x:Key="TrayMenu" MinWidth="248">
                <MenuItem
                    Header="{lc:Localization Tray_OpenMixer}"
                    FontWeight="SemiBold"
                    Command="{Binding TrayMixerCommand}"
                    Icon="{ui:SymbolIcon Options24}" />
                <MenuItem
                    Header="{lc:Localization TabHeader_Settings}"
                    Command="{Binding TraySettingsCommand}"
                    Icon="{ui:SymbolIcon Settings24}" />
                <MenuItem
                    Header="{lc:Localization Mixer_OutputDevice}"
                    ItemsSource="{Binding Source={StaticResource DeviceProviderViewModel}, Path=DeviceProvider.ActiveDevices}"
                    Icon="{ui:SymbolIcon Headphones24}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Icon">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource DeviceIsDefaultToIconConverter}">
                                        <Binding/>
                                        <Binding Source="{StaticResource DeviceProviderViewModel}" Path="DefaultDevice"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Header" Value="{Binding Master.DeviceFriendlyName}"/>
                            <Setter Property="Command" Value="{Binding Source={StaticResource DeviceProviderViewModel}, Path=SetDefaultDeviceTrayCommand}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem
                    Header="{lc:Localization TrayMenu_SoundPanel}"
                    Command="{Binding SoundControlPanelCommand}"
                    Icon="{ui:SymbolIcon Speaker224}" />
                <MenuItem
                    Header="{lc:Localization TrayMenu_SoundSettings}"
                    Command="{Binding SoundSettingsCommand}"
                    Icon="{ui:SymbolIcon Open24}" />
                <Separator />
                <MenuItem
                    Header="{lc:Localization TrayMenu_Exit}"
                    Command="{Binding TrayExitCommand}"
                    Icon="{ui:SymbolIcon Power24}" />
            </ContextMenu>

            <Storyboard x:Key="DisplayFadeIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 Storyboard.Target="{Binding ElementName=Window}"
                                 From="0" To="1" Duration="0:0:.12" />
            </Storyboard>

            <Storyboard x:Key="HideFadeOut">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 Storyboard.Target="{Binding ElementName=Window}"
                                 From="1" To="0" Duration="0:0:.12" />
            </Storyboard>

            <converters:WindowVisibilityConverter x:Key="WindowVisibilityConverter" />
            <converters:TrayTooltipConverter x:Key="TrayTooltipConverter"/>
            <converters:TrayIconConverter x:Key="TrayIconConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <MultiBinding x:Key="TrayIconBinding"
                          Converter="{StaticResource TrayIconConverter}">
                <Binding Source="{StaticResource DeviceProviderViewModel}" Path="DeviceProvider.NoOutputDevices" />
                <Binding Source="{StaticResource DeviceProviderViewModel}" Path="DefaultDevice.Master.Volume" />
                <Binding Source="{StaticResource DeviceProviderViewModel}" Path="DefaultDevice.Master.IsMuted" />
                <Binding Source="{StaticResource ThemeViewModel}" Path="WindowsTheme" />
                <Binding Source="{StaticResource AppBehaviorViewModel}" Path="DisplayDeviceIconAtTray"/>
                <Binding Source="{StaticResource DeviceProviderViewModel}" Path="DefaultDevice.Master.Icon" />
            </MultiBinding>

            <MultiBinding x:Key="TrayTextTooltip"
                          Converter="{StaticResource TrayTooltipConverter}">
                <Binding Source="{StaticResource DeviceProviderViewModel}"
                         Path="DeviceProvider.NoOutputDevices"/>
                <Binding Source="{StaticResource DeviceProviderViewModel}"
                         Path="DefaultDevice.Master"/>
                <Binding Source="{StaticResource DeviceProviderViewModel}"
                         Path="DefaultDevice.Master.IsMuted"/>
                <Binding Source="{StaticResource DeviceProviderViewModel}"
                         Path="DefaultDevice.Master.Volume"/>
                <Binding Source="{x:Static lc:TranslationSource.Instance}"
                         Path="CurrentCulture"/>
                <Binding Source="{StaticResource DeviceProviderViewModel}"
                         Path="DefaultDevice.Master.DeviceFriendlyName"/>
            </MultiBinding>
        </ResourceDictionary>
    </Window.Resources>

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger
            EventName="Closing"
            SourceObject="{Binding ElementName=Window}">
            <behaviors:InvokeCommandAction Command="{Binding Path=ClosingCommand}"
                                           PassEventArgsToCommand="True"/>
        </behaviors:EventTrigger>

        <behaviors:DataTrigger
            Binding="{Binding ElementName=Window, Path=IsVisible}"
            Value="False"
            Comparison="Equal">
            <behaviors:ControlStoryboardAction Storyboard="{StaticResource HideFadeOut}"/>
        </behaviors:DataTrigger>

        <behaviors:DataTrigger
            Binding="{Binding ElementName=Window, Path=IsVisible}"
            Value="True"
            Comparison="Equal">
            <behaviors:ControlStoryboardAction Storyboard="{StaticResource DisplayFadeIn}"/>
        </behaviors:DataTrigger>

        <behaviors:EventTrigger
            EventName="Deactivated"
            SourceObject="{Binding ElementName=Window}">
            <behaviors:InvokeCommandAction Command="{Binding Path=LostFocusCommand}"/>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.ShowInTaskbar>
        <Binding Path="DisplayMinimalistic" Converter="{StaticResource InverseBoolConverter}"/>
    </Window.ShowInTaskbar>

    <Window.Visibility>
        <Binding Path="WindowIsVisible" Converter="{StaticResource WindowVisibilityConverter}" />
    </Window.Visibility>

    <Window.Topmost>
        <Binding Path="AlwaysOnTop"/>
    </Window.Topmost>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            Name="Tray"
            NoLeftClickDelay="True"
            LeftClickCommand="{Binding TrayClickCommand}"
            ContextMenu="{StaticResource TrayMenu}" />

        <!-- window mode only; the popup has no title bar. Minimize and maximize stay off as before:
             the window hides to the tray instead -->
        <ui:TitleBar
            x:Name="TitleBar"
            Title="Volumey"
            Icon="{ui:SymbolIcon Speaker224}"
            ShowMinimize="False"
            ShowMaximize="False"
            Visibility="{Binding DisplayMinimalistic, Converter={StaticResource InverseBoolToVisibility}}" />

        <view:MixerView
            x:Name="Mixer"
            Grid.Row="1" />

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
