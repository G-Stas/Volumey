<UserControl x:Class="Volumey.View.Controls.VolumeNotificationContent"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:controls="clr-namespace:Volumey.Controls"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 xmlns:lc="clr-namespace:Volumey.Localization"
			 mc:Ignorable="d"
			 DataContext="{Binding RelativeSource={RelativeSource Self}}">
	<!-- the OSD's content, as before but with the WPF-UI controls (the OSD's redesign comes later) -->
	<Grid Width="Auto"
		  Margin="0 9 0 4">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="4*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
				   Grid.Column="1"
				   Grid.ColumnSpan="2"
				   Text="{Binding AudioSession.Name}"
				   Height="Auto"
				   FontSize="16"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Bottom"
				   TextWrapping="WrapWithOverflow"
				   TextTrimming="CharacterEllipsis"
				   LineHeight="18"
				   MaxHeight="45"
				   Margin="0 0 0 5"/>
		<Image Grid.Column="0"
			   Grid.Row="1"
			   Source="{Binding AudioSession.IconSource}"
			   RenderOptions.BitmapScalingMode="HighQuality"
			   VerticalAlignment="Center"
			   Height="{StaticResource ImageSize}"
			   Width="{StaticResource ImageSize}"
			   Margin="5, 0, 12, 0"/>
		<controls:VolumeSlider Grid.Column="1"
							   Grid.Row="1"
							   Value="{Binding AudioSession.Volume, UpdateSourceTrigger=PropertyChanged}"
							   IsMuted="{Binding AudioSession.IsMuted}"
							   Height="{StaticResource SliderHeight}"
							   Width="Auto"
							   HorizontalAlignment="Stretch"/>
		<TextBlock Grid.Column="2"
				   Grid.Row="1"
				   Text="{Binding AudioSession.Volume}"
				   FontSize="19"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   Margin="10 0 7 0"/>
		<ui:Button Grid.Column="3"
				   Grid.Row="1"
				   Style="{StaticResource IconButton}"
				   Tag="{Binding AudioSession.IsMuted}"
				   Command="{Binding AudioSession.MuteCommand}"
				   HorizontalAlignment="Left">
			<AutomationProperties.Name>
				<MultiBinding Converter="{StaticResource MuteButtonName}">
					<Binding Path="AudioSession.IsMuted" />
					<Binding Path="AudioSession.Name" />
					<Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
				</MultiBinding>
			</AutomationProperties.Name>
			<ui:SymbolIcon Style="{StaticResource MuteIcon}" />
		</ui:Button>
	</Grid>
</UserControl>
