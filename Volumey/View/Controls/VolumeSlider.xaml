<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Volumey.Controls">

    <!-- the part of the track left of the thumb: the accent fill of Windows 11's sliders (WPF-UI 4.3's slider has none) -->
    <Style x:Key="VolumeSliderFillButton" TargetType="RepeatButton" BasedOn="{StaticResource UiSliderButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            CornerRadius="2"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI's horizontal slider template plus the fill -->
    <ControlTemplate x:Key="VolumeSliderTemplate" TargetType="controls:VolumeSlider">
        <Grid>
            <Border x:Name="TrackBackground"
                    Height="4"
                    Background="{DynamicResource SliderTrackFill}"
                    CornerRadius="2" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource VolumeSliderFillButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource UiSliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource UiSliderButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="Thumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- WPF-UI's (Windows 11) slider with the fill; only the behavior is set here -->
    <Style TargetType="controls:VolumeSlider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="EnableMouseWheel" Value="True" />
        <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <!-- WPF-UI sets its template in an Orientation trigger, which a plain setter can't override -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource VolumeSliderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
