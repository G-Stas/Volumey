<Page x:Class="Volumey.View.SettingsPage.MediaKeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lc="clr-namespace:Volumey.Localization"
      xmlns:converters="clr-namespace:Volumey.View.Converters"
      xmlns:controls="clr-namespace:Volumey.Controls"
      xmlns:viewControls="clr-namespace:Volumey.View.Controls"
      Title="{lc:Localization Nav_MediaKeys}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      DataContext="{Binding Source={StaticResource SettingsViewModel}, Path=SystemHotkeysViewModel}">
    <!-- the Foreground: see GeneralPage -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Volumey;component/View/Styles/SettingsPage.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:LocalizedFormatConverter x:Key="LocalizedFormat" />
        </ResourceDictionary>
    </Page.Resources>

    <!-- mockup SettingsMedia.dc.html: one row per media key, its hotkey changed in place and cleared with the X button -->
    <!-- no ScrollViewer here: see GeneralPage -->
    <StackPanel Margin="16 4 40 32">
        <TextBlock Text="{lc:Localization Nav_MediaKeys}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{lc:Localization Media_Description}" Style="{StaticResource PageDescription}" />

        <TextBlock Text="{lc:Localization Media_Hotkeys}" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" AutomationProperties.AutomationId="MediaKeyList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl AutomationProperties.Name="{Binding Name}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Stop24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MediaKey}" Value="MediaPlayPause">
                                                <Setter Property="Symbol" Value="Play24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MediaKey}" Value="MediaPreviousTrack">
                                                <Setter Property="Symbol" Value="Previous24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MediaKey}" Value="MediaNextTrack">
                                                <Setter Property="Symbol" Value="Next24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <controls:HotKeyBox HotKey="{Binding Hotkey}"
                                                    AutomationProperties.Name="{Binding Name}" />
                                <TextBlock Text="{Binding Error}" Style="{StaticResource SettingError}" MaxWidth="180" HorizontalAlignment="Left" Margin="0 4 0 0" />
                            </StackPanel>
                            <!-- left of the box, so the boxes end at the card's edge like on the other pages;
                                 hidden, not collapsed, while there's no hotkey: the boxes stay in line -->
                            <ui:Button Margin="0 0 8 0"
                                       VerticalAlignment="Top"
                                       Appearance="Transparent"
                                       BorderThickness="0"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       Command="{Binding ClearCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <AutomationProperties.Name>
                                    <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="Media_Clear">
                                        <Binding Path="Name" />
                                        <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                    </MultiBinding>
                                </AutomationProperties.Name>
                                <ui:Button.ToolTip>
                                    <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="Media_Clear">
                                        <Binding Path="Name" />
                                        <Binding Source="{x:Static lc:TranslationSource.Instance}" Path="CurrentCulture" />
                                    </MultiBinding>
                                </ui:Button.ToolTip>
                            </ui:Button>
                        </Grid>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <viewControls:HotkeyModeNote />
    </StackPanel>
</Page>
