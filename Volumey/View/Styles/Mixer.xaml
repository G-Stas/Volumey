<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:Volumey.View.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- true = collapsed (the app's BoolToVisibilityConverter is the inverse of WPF's) -->
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <!-- "Mute Spotify" / "Unmute Spotify": what a screen reader says for a mute button -->
    <converters:MuteButtonNameConverter x:Key="MuteButtonName" />

    <!-- a transparent square icon button (mute, settings) -->
    <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- the icon of a mute button: put the muted state in the button's Tag -->
    <Style x:Key="MuteIcon" TargetType="ui:SymbolIcon">
        <Setter Property="Symbol" Value="Speaker224" />
        <Setter Property="FontSize" Value="18" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                <Setter Property="Symbol" Value="SpeakerMute24" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- the volume number next to a slider -->
    <Style x:Key="VolumeValue" TargetType="TextBlock">
        <Setter Property="Width" Value="28" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- a small caption above a control ("Output device") -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <!-- secondary, as Windows 11 Settings' descriptions: WPF-UI's tertiary was hard to read in the light theme (owner) -->
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
