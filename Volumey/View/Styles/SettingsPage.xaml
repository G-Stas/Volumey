<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:lc="clr-namespace:Volumey.Localization"
                    xmlns:controls="clr-namespace:Volumey.Controls">
    <!-- shared by the settings pages: each page merges this into its own resources (the implicit styles mustn't reach the mixer) -->

    <!-- the page title and its description -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    </Style>
    <Style x:Key="PageDescription" TargetType="TextBlock">
        <Setter Property="Margin" Value="0 4 0 0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- a setting's title wraps instead of being cut off when the control next to it is wide -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 20 0 8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="0 0 0 4" />
    </Style>
    <!-- the expand button gets the card's AutomationProperties.Name, so every CardExpander needs one -->
    <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
        <Setter Property="controls:ExpanderButtonName.IsEnabled" Value="True" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="220" />
    </Style>
    <!-- a key cap in a hotkey box; the elevation border is darker at the bottom, like a key -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7 0" />
        <Setter Property="Margin" Value="0 0 4 0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1 1 1 2" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    </Style>
    <!-- the app's hotkey box is a TextBox subclass, which WPF-UI's implicit TextBox style doesn't reach. It shows the hotkey
         as key caps; the template follows WPF-UI's TextBox template (its brushes, the accent line at the bottom
         when focused). The text itself stays in the hidden content host: the box still works as a TextBox and screen readers read it. -->
    <Style TargetType="controls:HotKeyBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <!-- a wider box squeezes the setting's title next to it (French), so a long placeholder gets smaller instead -->
        <Setter Property="Width" Value="180" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="PlaceholderText" Value="{lc:Localization HotkeyBox_Placeholder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HotKeyBox">
                    <!-- the box, and under it the message for a combination someone else holds (HotKeyBox.TakenMessage), styled like SettingError -->
                    <StackPanel>
                        <Grid>
                            <Border x:Name="ContentBorder"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding Border.CornerRadius}">
                                <Grid Margin="6 0">
                                    <ScrollViewer x:Name="PART_ContentHost" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                                    <!-- the empty box shows what it takes: a keyboard and a mouse (Windows' glyphs) -->
                                    <StackPanel x:Name="Placeholder"
                                                Orientation="Horizontal"
                                                Margin="4 0 0 0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <TextBlock Text="&#xE765;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextControlPlaceholderForeground}" />
                                        <TextBlock Text="{lc:Localization HotkeyBox_Or}"
                                                   Margin="6 0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource TextControlPlaceholderForeground}" />
                                        <TextBlock Text="&#xE962;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextControlPlaceholderForeground}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{TemplateBinding Caps}" VerticalAlignment="Center" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KeyCap}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- a mouse button's cap starts with Windows' mouse glyph -->
                                                        <TextBlock x:Name="MouseIcon"
                                                                   Text="&#xE962;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   Margin="0 0 4 0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:HotKeyBox}}" />
                                                        <!-- the box's Foreground set locally: WPF-UI's TextBlock style switches a disabled
                                                             TextBlock to its disabled color itself, which ignores the box's -->
                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:HotKeyBox}}" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouse}" Value="True">
                                                        <Setter TargetName="MouseIcon" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border x:Name="AccentBorder"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0 0 0 1"
                                    CornerRadius="{TemplateBinding Border.CornerRadius}" />
                        </Grid>
                        <TextBlock x:Name="TakenMessage"
                                   Margin="0 4 0 0"
                                   Text="{TemplateBinding TakenMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TakenMessage" Value="{x:Null}">
                            <Setter TargetName="TakenMessage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="AccentBorder" Property="BorderThickness" Value="0 0 0 2" />
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushDisabled}" />
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushDisabled}" />
                            <!-- the keys in the secondary text color, not WPF-UI's disabled one: that one is hard to read
                                 on the key caps in the light theme -->
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- an error under a setting (e.g. a hotkey that couldn't be registered), in the Windows "critical" color -->
    <Style x:Key="SettingError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <!-- as in Windows 11 Settings, hovering only grows the knob (WPF-UI's template does that); the track keeps its color.
             WPF-UI's hover brushes are replaced by the normal ones, same color references as its Light/Dark themes -->
        <Style.Resources>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SystemAccentColorPrimary}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource SystemAccentColorPrimary}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource ControlAltFillColorSecondary}" />
        </Style.Resources>
        <Setter Property="OnContent" Value="{lc:Localization Toggle_On}" />
        <Setter Property="OffContent" Value="{lc:Localization Toggle_Off}" />
        <Setter Property="LabelPosition" Value="Left" />
    </Style>
</ResourceDictionary>
