<ui:ContentDialog x:Class="Volumey.View.DialogContent.SupportDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:lc="clr-namespace:Volumey.Localization"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  mc:Ignorable="d"
                  DialogMargin="12"
                  CloseButtonText="{lc:Localization Support_NotNow}">
    <!-- the dialog's own title area: the heart before the title -->
    <ui:ContentDialog.Title>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Heart24"
                           Filled="True"
                           FontSize="24"
                           Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{lc:Localization Support_Title}"
                       TextWrapping="Wrap" />
        </Grid>
    </ui:ContentDialog.Title>
    <Grid>
        <!-- the offer: one sentence and the tiers -->
        <StackPanel x:Name="Offer">
            <TextBlock Text="{lc:Localization Support_Text}"
                       TextWrapping="Wrap" />
            <ItemsControl x:Name="TierList"
                          Margin="0 12 0 0"
                          ItemsSource="{Binding Tiers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Margin="0 0 0 4"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch"
                                   AutomationProperties.Name="{Binding Title}"
                                   Click="OnTierClick">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <!-- the middle tier is the suggested one -->
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1"
                                           Margin="12 0 0 0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Price}"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Status"
                       Margin="0 4 0 0"
                       Text="{lc:Localization Support_Failed}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- after a purchase -->
        <StackPanel x:Name="Thanks"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Heart24"
                           Filled="True"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock Margin="0 8 0 8"
                       HorizontalAlignment="Center"
                       Text="{lc:Localization Support_ThanksTitle}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{lc:Localization Support_ThanksText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ui:ContentDialog>
