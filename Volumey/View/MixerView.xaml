<UserControl x:Class="Volumey.View.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:view="clr-namespace:Volumey.View"
             xmlns:converters="clr-namespace:Volumey.View.Converters"
             xmlns:lc="clr-namespace:Volumey.Localization"
             xmlns:controls="clr-namespace:Volumey.Controls"
             mc:Ignorable="d"
             controls:VolumeSlider.ShowsLevel="{Binding Meters.ShowLevels}">
    <UserControl.Resources>
        <converters:DeviceViewPositionToDockConverter x:Key="DeviceViewPositionConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- the bottom bar, in both modes -->
        <Border x:Name="Footer"
                DockPanel.Dock="Bottom"
                Height="48"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0 1 0 0">
            <DockPanel Margin="8 0 6 0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Left"
                           Appearance="Transparent"
                           BorderThickness="0"
                           Padding="10 6"
                           Icon="{ui:SymbolIcon Open24}"
                           Content="{lc:Localization TrayMenu_SoundSettings}"
                           Command="{Binding Window.MixerSoundSettingsCommand}" />
                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource IconButton}"
                           ToolTip="{lc:Localization Mixer_OpenSettings}"
                           AutomationProperties.Name="{lc:Localization Mixer_OpenSettings}"
                           AutomationProperties.AutomationId="SettingsButton"
                           Command="{Binding Window.TraySettingsCommand}">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                </ui:Button>
            </DockPanel>
        </Border>

        <!-- MasterView sets the devices as the DataContext of its content, so its own DataContext is still this view's -->
        <view:MasterView DockPanel.Dock="{Binding Window.DeviceViewAtTheBottom, Converter={StaticResource DeviceViewPositionConverter}}"
                         Margin="16 12 16 12" />

        <Border DockPanel.Dock="{Binding Window.DeviceViewAtTheBottom, Converter={StaticResource DeviceViewPositionConverter}}"
                Height="1"
                Margin="16 0"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <TabControl DockPanel.Dock="Top" Margin="8 4 8 0">
            <TabItem Header="{lc:Localization Mixer_Apps}">
                <ScrollViewer x:Name="ScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0 0 0 4">
                    <view:SessionsListView x:Name="SessionsList" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{lc:Localization Mixer_HiddenSources}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0 0 0 4">
                    <view:SessionsListView ShowHiddenSources="True" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
