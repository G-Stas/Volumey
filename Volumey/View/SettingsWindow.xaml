<ui:FluentWindow x:Class="Volumey.View.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Volumey.View.SettingsPage"
                 xmlns:lc="clr-namespace:Volumey.Localization"
                 xmlns:converters="clr-namespace:Volumey.View.Converters"
                 Title="{lc:Localization SettingsWindow_Title}"
                 Width="800"
                 MinWidth="800"
                 Height="880"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 DataContext="{StaticResource SettingsViewModel}"
                 Closing="OnClosing">
    <!-- mockups Settings*.dc.html: a title bar, the pages on the left, Support at the bottom. MinWidth: narrower than 800 the cards break
         (titles wrap letter by letter, e.g. "Distance from the edges"); WPF-UI's default minimum is 460 (owner) -->
    <ui:FluentWindow.Resources>
        <converters:CollectionCountToVisibilityConverter x:Key="NoneToCollapsed" CountLimit="0" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{lc:Localization SettingsWindow_Title}" Icon="{ui:SymbolIcon Speaker224}" />

        <ui:NavigationView Grid.Row="1"
                           x:Name="Navigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="280">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavGeneral" Content="{lc:Localization Nav_General}" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavMixer" Content="{lc:Localization Nav_Mixer}" Icon="{ui:SymbolIcon Options24}"
                                       TargetPageType="{x:Type pages:MixerPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavAppHotkeys" Content="{lc:Localization Nav_AppHotkeys}" Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:AppHotkeysPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavDevices" Content="{lc:Localization Nav_Devices}" Icon="{ui:SymbolIcon Speaker224}"
                                       TargetPageType="{x:Type pages:DevicesPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavMediaKeys" Content="{lc:Localization Nav_MediaKeys}" Icon="{ui:SymbolIcon Keyboard24}"
                                       TargetPageType="{x:Type pages:MediaKeysPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavNotifications" Content="{lc:Localization Nav_Notifications}" Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:NotificationsPage}" />
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavAbout" Content="{lc:Localization Nav_About}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem AutomationProperties.AutomationId="NavSupport" Content="{lc:Localization Nav_Support}" Icon="{ui:SymbolIcon Heart24}"
                                       Visibility="{Binding About.SupportLinks.Count, Converter={StaticResource NoneToCollapsed}}"
                                       Click="OnSupportClick" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- dialogs of the settings pages (App hotkeys: Add app) -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
