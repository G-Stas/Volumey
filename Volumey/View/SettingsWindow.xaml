<ui:FluentWindow x:Class="Volumey.View.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Volumey.View.SettingsPage"
                 xmlns:lc="clr-namespace:Volumey.Localization"
                 Title="{lc:Localization SettingsWindow_Title}"
                 Width="1040"
                 Height="960"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 DataContext="{StaticResource SettingsViewModel}"
                 Closing="OnClosing">
    <!-- mockups Settings*.dc.html: a title bar, the pages on the left, Source code and Support at the bottom -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{lc:Localization SettingsWindow_Title}" Icon="{ui:SymbolIcon Speaker224}" />

        <ui:NavigationView Grid.Row="1"
                           x:Name="Navigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="280">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{lc:Localization Nav_General}" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_Mixer}" Icon="{ui:SymbolIcon Options24}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_AppHotkeys}" Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_Devices}" Icon="{ui:SymbolIcon Speaker224}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_MediaKeys}" Icon="{ui:SymbolIcon Keyboard24}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_Notifications}" Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_About}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:PlaceholderPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{lc:Localization Nav_SourceCode}" Icon="{ui:SymbolIcon Code24}"
                                       Command="{Binding GitHubCommand}" />
                <ui:NavigationViewItem Content="{lc:Localization Nav_Support}" Icon="{ui:SymbolIcon Heart24}"
                                       Command="{Binding TipCommand}"
                                       CommandParameter="{Binding TipSource.Item2}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
