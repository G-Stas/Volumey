<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Lowest Windows version the app runs on (matches the Store package TargetPlatformMinVersion) -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- CsWin32's generated declarations use pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- nullable reference types are turned on per file (#nullable enable); in those files their warnings are errors -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <Platforms>x64</Platforms>
    <RootNamespace>Volumey</RootNamespace>
    <StartupObject>Volumey.Startup</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Configurations>Debug;Release;Store</Configurations>
    <!-- The Store MSIX carries its own .NET runtime; the GitHub zip build needs the .NET Desktop Runtime installed -->
    <SelfContained Condition="'$(Configuration)'=='Store'">True</SelfContained>
    <SelfContained Condition="'$(Configuration)'!='Store'">False</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <Version>2.1.0.0</Version>
  </PropertyGroup>

  <!-- Self-contained builds (the Store MSIX, the GitHub zip) are trimmed. WPF doesn't support trimming, so only assemblies marked
       trimmable are trimmed (partial): the runtime libraries, the Windows SDK projection, NAudio, SharpHook and a few others;
       WPF, WinForms, WPF-UI and the app stay whole. ReadyToRun compiles the trimmed assemblies again: trimming drops the runtime's
       precompiled code, which made the start about 3 times slower. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- NAudio and the shortcut code use classic COM interop -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- AutoUpdater.NET's resources hold images (resource types other than strings) -->
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
    <!-- WPF, its XAML and most libraries aren't annotated for trimming: thousands of warnings, mostly about code that partial mode
         keeps whole -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <!-- XAML creates TaskbarIcon and its parts through reflection -->
    <TrimmerRootAssembly Include="H.NotifyIcon" />
    <TrimmerRootAssembly Include="H.NotifyIcon.Wpf" />
    <!-- named only inside AutoUpdater.NET's resources, as their reader -->
    <TrimmerRootAssembly Include="System.Resources.Extensions" />
    <!-- whole for their COM interfaces: a COM interface without its unused methods calls the wrong vtable slots -->
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
    <TrimmerRootAssembly Include="Microsoft.VisualBasic.Core" />
    <TrimmerRootAssembly Include="System.DirectoryServices" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <!-- Desktop assemblies the app only uses in part: trimmed too. WinForms itself stays whole (AutoUpdater.NET's forms name
         its types in resources), so do Ribbon and WindowsFormsIntegration (the XAML loader loads every assembly of the WPF
         namespace) and the themes that ship (WPF loads them by name). -->
    <TrimmableAssembly Include="System.Windows.Forms.Design" />
    <TrimmableAssembly Include="System.Windows.Forms.Design.Editors" />
    <TrimmableAssembly Include="System.Design" />
    <TrimmableAssembly Include="System.Drawing.Design" />
    <TrimmableAssembly Include="Microsoft.VisualBasic.Forms" />
    <TrimmableAssembly Include="UIAutomationClientSideProviders" />
    <TrimmableAssembly Include="ReachFramework" />
    <TrimmableAssembly Include="PresentationUI" />
    <!-- The settings and the support links only read and write plain JSON: the converters they use are named in code -->
    <TrimmableAssembly Include="Newtonsoft.Json" />
  </ItemGroup>
  <!-- The Store build updates through the Store: AutoUpdater.NET and its WebView2 aren't used there, and the trimmer drops them.
       Without AutoUpdater.NET's forms nothing uses WinForms, so it's trimmed there too. -->
  <ItemGroup Condition="'$(Configuration)' == 'Store'">
    <TrimmableAssembly Include="System.Windows.Forms" />
    <TrimmableAssembly Include="System.Windows.Forms.Primitives" />
    <TrimmableAssembly Include="AutoUpdater.NET" />
    <TrimmableAssembly Include="Microsoft.Web.WebView2.Core" />
    <TrimmableAssembly Include="Microsoft.Web.WebView2.WinForms" />
    <TrimmableAssembly Include="Microsoft.Web.WebView2.Wpf" />
  </ItemGroup>
  <Target Name="RemoveWebView2LoaderFromStorePublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Store'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'WebView2Loader'" />
    </ItemGroup>
  </Target>

  <!-- ReadyToRun only for what runs: assemblies the app doesn't load in normal use (start, mixer, settings, OSD, update check),
       and three big ones it loads at start but barely uses (about 12 ms more at start), are compiled on first use instead -->
  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <PublishReadyToRunExclude Include="System.Private.Xml.dll" />
    <PublishReadyToRunExclude Include="System.Linq.Expressions.dll" />
    <PublishReadyToRunExclude Include="System.Data.Common.dll" />
    <PublishReadyToRunExclude Include="H.GeneratedIcons.System.Drawing.dll" />
    <PublishReadyToRunExclude Include="Microsoft.CSharp.dll" />
    <PublishReadyToRunExclude Include="Microsoft.VisualBasic.Core.dll" />
    <PublishReadyToRunExclude Include="Microsoft.VisualBasic.Forms.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Core.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.WinForms.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Wpf.dll" />
    <PublishReadyToRunExclude Include="PresentationUI.dll" />
    <PublishReadyToRunExclude Include="ReachFramework.dll" />
    <PublishReadyToRunExclude Include="System.ComponentModel.Annotations.dll" />
    <PublishReadyToRunExclude Include="System.Console.dll" />
    <PublishReadyToRunExclude Include="System.Diagnostics.EventLog.dll" />
    <PublishReadyToRunExclude Include="System.Diagnostics.StackTrace.dll" />
    <PublishReadyToRunExclude Include="System.Diagnostics.TextWriterTraceListener.dll" />
    <PublishReadyToRunExclude Include="System.DirectoryServices.dll" />
    <PublishReadyToRunExclude Include="System.Formats.Asn1.dll" />
    <PublishReadyToRunExclude Include="System.Formats.Nrbf.dll" />
    <PublishReadyToRunExclude Include="System.IO.Compression.Brotli.dll" />
    <PublishReadyToRunExclude Include="System.IO.Compression.dll" />
    <PublishReadyToRunExclude Include="System.IO.FileSystem.AccessControl.dll" />
    <PublishReadyToRunExclude Include="System.IO.FileSystem.DriveInfo.dll" />
    <PublishReadyToRunExclude Include="System.IO.FileSystem.Watcher.dll" />
    <PublishReadyToRunExclude Include="System.IO.IsolatedStorage.dll" />
    <PublishReadyToRunExclude Include="System.IO.MemoryMappedFiles.dll" />
    <PublishReadyToRunExclude Include="System.IO.Pipelines.dll" />
    <PublishReadyToRunExclude Include="System.Net.Mail.dll" />
    <PublishReadyToRunExclude Include="System.Net.NetworkInformation.dll" />
    <PublishReadyToRunExclude Include="System.Private.DataContractSerialization.dll" />
    <PublishReadyToRunExclude Include="System.Private.Xml.Linq.dll" />
    <PublishReadyToRunExclude Include="System.Resources.Writer.dll" />
    <PublishReadyToRunExclude Include="System.Security.AccessControl.dll" />
    <PublishReadyToRunExclude Include="System.Security.Cryptography.Pkcs.dll" />
    <PublishReadyToRunExclude Include="System.Security.Cryptography.ProtectedData.dll" />
    <PublishReadyToRunExclude Include="System.Security.Cryptography.Xml.dll" />
    <PublishReadyToRunExclude Include="System.Text.Encoding.CodePages.dll" />
    <PublishReadyToRunExclude Include="System.Text.Encodings.Web.dll" />
    <PublishReadyToRunExclude Include="System.Text.Json.dll" />
    <PublishReadyToRunExclude Include="System.Threading.AccessControl.dll" />
    <PublishReadyToRunExclude Include="System.Threading.Channels.dll" />
    <PublishReadyToRunExclude Include="System.Windows.Forms.Design.dll" />
  </ItemGroup>
  <!-- Release builds ship without the app's symbols and the libraries' XML docs -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <!-- WPF themes of older Windows and the opt-in Fluent theme: on Windows 10 and 11 WPF loads Aero2, AeroLite with high contrast
       and Classic without visual styles -->
  <Target Name="RemoveUnusedThemesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'PresentationFramework.Aero' Or '%(Filename)' == 'PresentationFramework.Luna' Or '%(Filename)' == 'PresentationFramework.Royale' Or '%(Filename)' == 'PresentationFramework.Fluent'" />
    </ItemGroup>
  </Target>
  <!-- Self-contained builds ship without the runtime's debugger files (attaching a debugger, reading dumps) -->
  <Target Name="RemoveDebuggerFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'mscordbi' Or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' Or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))" />
    </ItemGroup>
  </Target>

  <!-- portable PDBs: with Windows PDBs (pdbonly/full) the settings weaver rewrites the symbols through the native symbol writer,
       which sometimes crashes the build -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Store|x64'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants)TRACE;STORE</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.3" />
    <PackageReference Include="log4net-loggly" Version="9.0.0" />
    <!-- Override vulnerable transitive versions pulled in by log4net-loggly (log4net 2.0.8, Newtonsoft.Json 10.0.3) -->
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <!-- Fluent (Windows 11) controls and themes -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Core Audio (devices, endpoint volume, audio sessions) -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Non-blocking global hotkeys (low-level keyboard hook); ships the native uiohook.dll -->
    <PackageReference Include="SharpHook" Version="8.0.0" />
    <!-- Tray icon (successor of Hardcodet.NotifyIcon.Wpf) -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- Settings (settings.json): autosave and change notifications are woven into the settings classes at build time -->
    <PackageReference Include="Nucs.JsonSettings" Version="2.3.2" />
    <PackageReference Include="Nucs.JsonSettings.Autosave" Version="2.3.2" />
    <PackageReference Include="Nucs.JsonSettings.NotifyChanges" Version="2.3.2" />
    <PackageReference Include="WpfScreenHelper" Version="2.1.0" />
    <!-- generates the Win32 declarations listed in NativeMethods.txt -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Volumey.Tests" />
    <InternalsVisibleTo Include="Volumey.IntegrationTests" />
    <!-- Moq's proxies, for mocking internal interfaces (IWin32) -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.de.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.en.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.es.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.fr.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.hi.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.it.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.ja.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.pt.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.ru.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.zh.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.uk-ua.resx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings\Resources\Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Resource Include="Resources\Icons\TrayDark\high.ico" />
    <Resource Include="Resources\Icons\TrayDark\low.ico" />
    <Resource Include="Resources\Icons\TrayDark\mid.ico" />
    <Resource Include="Resources\Icons\TrayDark\mute.ico" />
    <Resource Include="Resources\Icons\TrayDark\no-device.ico" />
    <Resource Include="Resources\Icons\TrayLight\high.ico" />
    <Resource Include="Resources\Icons\TrayLight\low.ico" />
    <Resource Include="Resources\Icons\TrayLight\mid.ico" />
    <Resource Include="Resources\Icons\TrayLight\mute.ico" />
    <Resource Include="Resources\Icons\TrayLight\no-device.ico" />
    <Resource Include="Resources\Icons\icon.ico" />
    <Resource Include="Resources\Icons\ButtonIcon\github.png" />
    <Resource Include="Resources\Icons\ButtonIcon\github-dark.png" />
    <Resource Include="Resources\Icons\ButtonIcon\mug.png" />
    <Resource Include="Resources\Icons\ButtonIcon\mug-dark.png" />
    <Resource Include="Resources\Icons\ButtonIcon\mugEmpty.png" />
    <Resource Include="Resources\Icons\ButtonIcon\mugEmpty-dark.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Strings\Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Resources\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- The Loggly input key of Release/Store builds (Helper/RemoteLogging): from the environment variable VOLUMEY_LOGGLY_INPUT_KEY
       or the git-ignored loggly.key at the repository root. Without one the build doesn't send logs. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <LogglyInputKey Condition="'$(LogglyInputKey)' == ''">$(VOLUMEY_LOGGLY_INPUT_KEY)</LogglyInputKey>
    <LogglyKeyFile>$(MSBuildThisFileDirectory)..\loggly.key</LogglyKeyFile>
    <LogglyInputKey Condition="'$(LogglyInputKey)' == '' And Exists('$(LogglyKeyFile)')">$([System.IO.File]::ReadAllText('$(LogglyKeyFile)').Trim())</LogglyInputKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(LogglyInputKey)' != ''">
    <AssemblyMetadata Include="LogglyInputKey" Value="$(LogglyInputKey)" />
  </ItemGroup>
  <Target Name="ReportNoLogglyKey" BeforeTargets="CoreCompile" Condition="'$(Configuration)' != 'Debug' And '$(LogglyInputKey)' == ''">
    <Message Importance="high" Text="No Loggly input key (VOLUMEY_LOGGLY_INPUT_KEY or loggly.key): this build doesn't send logs" />
  </Target>

  <ItemGroup>
    <Resource Include="Resources\Icons\ButtonIcon\boosty.png" />
  </ItemGroup>
</Project>
