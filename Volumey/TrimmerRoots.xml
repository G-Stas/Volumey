<linker>
  <!-- COM interfaces keep every method: without its unused methods a COM interface calls the wrong vtable slots
       (IPersistFile in SystemIntegrationHelper's shortcuts) -->
  <assembly fullname="System.Private.CoreLib">
    <namespace fullname="System.Runtime.InteropServices.ComTypes" preserve="all" />
  </assembly>
  <assembly fullname="System.Windows.Forms.Primitives">
    <type fullname="Microsoft.Office.IMsoComponentManager/Interface" preserve="all" />
  </assembly>
  <assembly fullname="ReachFramework">
    <namespace fullname="System.Windows.Xps.Serialization.RCW" preserve="all" />
  </assembly>
</linker>
