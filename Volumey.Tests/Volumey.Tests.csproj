<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <!-- Must match the app's TFM -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>

    <IsPackable>false</IsPackable>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <RootNamespace>Volumey.Tests</RootNamespace>

    <Configurations>Debug;Release;Store</Configurations>

    <!-- No settings classes here: don't run the settings library's build-time weaving inherited from the app's packages -->
    <AspectInjector_Enabled>false</AspectInjector_Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Volumey\Volumey.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Volumey\Resources\Icons\icon.ico" Link="TestData\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
